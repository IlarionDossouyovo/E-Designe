{
  "instructions": "CONFIGURATION FIREBASE - E-DÉSIGNE",
  "steps": [
    {
      "step": 1,
      "action": "Créer un projet Firebase",
      "url": "https://console.firebase.google.com",
      "details": "Cliquez sur 'Ajouter un projet' et suivez les instructions"
    },
    {
      "step": 2,
      "action": "Activer l'authentification",
      "path": "Authentication > Méthode de connexion",
      "enable": ["Email/Password", "Google"]
    },
    {
      "step": 3,
      "action": "Obtenir la configuration",
      "path": "Paramètres du projet > Général > Vos applications",
      "details": "Cliquez sur l'icône Web (</>) pour créer une app web"
    }
  ],
  "required_vars": {
    "VITE_FIREBASE_API_KEY": "AIzaSy...",
    "VITE_FIREBASE_PROJECT_ID": "e-designe-xxxxx",
    "VITE_FIREBASE_AUTH_DOMAIN": "e-designe-xxxxx.firebaseapp.com",
    "VITE_FIREBASE_STORAGE_BUCKET": "e-designe-xxxxx.appspot.com",
    "VITE_FIREBASE_MESSAGING_SENDER_ID": "123456789",
    "VITE_FIREBASE_APP_ID": "1:123456789:web:abc123..."
  },
  "example_config": {
    "apiKey": "AIzaSyDxxxxxxxxxxxxxx",
    "authDomain": "e-designe.firebaseapp.com",
    "projectId": "e-designe",
    "storageBucket": "e-designe.appspot.com",
