# ============================================
# E-DÉSIGNE - CONFIGURATION ENVIRONNEMENT
# ============================================
# Copiez ce fichier vers .env et remplissez les valeurs

# --- STRIPE (Paiements) ---
# Obtenez vos clés sur https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete
STRIPE_PUBLIC_KEY=pk_test_votre_cle_publique
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# --- PAYPAL (Paiements) ---
# Obtenez vos clés sur https://developer.paypal.com
PAYPAL_CLIENT_ID=votre_client_id
PAYPAL_CLIENT_SECRET=votre_client_secret
PAYPAL_MODE=sandbox  # changer en 'live' pour production

# --- RESEND (Emails) ---
# Déjà configuré: re_Dj8diRCn_CJ1eDHXVtSKWdbYRw5TRz4ok
RESEND_API_KEY=re_Dj8diRCn_CJ1eDHXVtSKWdbYRw5TRz4ok
FROM_EMAIL=noreply@e-designe.com
SUPPORT_EMAIL=support@e-designe.com

# --- FIREBASE (Authentification) ---
# Créez un projet sur https://console.firebase.google.com
VITE_FIREBASE_API_KEY=votre_api_key
VITE_FIREBASE_PROJECT_ID=votre_project_id
VITE_FIREBASE_AUTH_DOMAIN=votre_projet.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=votre_projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=votre_sender_id
VITE_FIREBASE_APP_ID=votre_app_id

# --- SUPABASE (Base de données) ---
# Configuré automatiquement - voir supabase.json
VITE_SUPABASE_URL=votre_url_supabase
VITE_SUPABASE_ANON_KEY=votre_cle_anon

# --- ANALYTICS (Optionnel) ---
# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel
VITE_META_PIXEL_ID=your_pixel_id
