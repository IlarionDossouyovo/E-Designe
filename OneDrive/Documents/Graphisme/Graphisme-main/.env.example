# ==============================================
# Graphisme by ELECTRON - Environment Variables
# Complete Configuration for AI Agents & Social Media
# ==============================================

# ==============================================
# CORE CONFIGURATION
# ==============================================

# Node Environment
NODE_ENV=development

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==============================================
# AI SERVICES CONFIGURATION
# ==============================================

# Ollama (Local AI - Already configured)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (GPT Models) - Get from https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (Claude Models) - Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI (Gemini) - Get from https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Cohere AI - Get from https://dashboard.cohere.com
COHERE_API_KEY=your-cohere-api-key-here

# ==============================================
# SOCIAL MEDIA APIs
# ==============================================

# Facebook & Instagram (Meta for Developers)
# Get from: https://developers.facebook.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id

# Instagram Basic Display
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# TikTok (TikTok for Developers)
# Get from: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_OPEN_ID=your-tiktok-open-id

# YouTube (Google Cloud Console)
# Get from: https://console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# LinkedIn (LinkedIn Developers)
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_ORGANIZATION_ID=your-linkedin-organization-id

# Twitter/X (Twitter Developers)
# Get from: https://developer.twitter.com
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ==============================================
# MESSAGING PLATFORMS
# ==============================================

# WhatsApp Business API (Meta for Developers)
# Get from: https://developers.facebook.com/docs/whatsapp
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# Telegram Bot
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ==============================================
# EMAIL SERVICES
# ==============================================

# Resend (Recommended) - Get from https://resend.com
RESEND_API_KEY=re_your-resend-api-key-here
EMAIL_FROM=noreply@graphisme.electron

# SendGrid - Get from https://sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun - Get from https://mailgun.com
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org

# ==============================================
# CLOUD & STORAGE
# ==============================================

# AWS (Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Cloudinary (Image/Video Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ==============================================
# ANALYTICS
# ==============================================

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel (Facebook)
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# ==============================================
# PAYMENT PROCESSING
# ==============================================

# Stripe - Get from https://dashboard.stripe.com
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal - Get from https://developer.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ==============================================
# AUTOMATION TOOLS
# ==============================================

# n8n Workflow Automation
N8N_API_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# Open WebUI (Ollama GUI)
OPEN_WEBUI_URL=http://localhost:8080
OPEN_WEBUI_API_KEY=your-open-webui-api-key

# ==============================================
# OTHER SERVICES
# ==============================================

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# File Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./public/uploads

# ==============================================
# PRODUCTION ONLY (DO NOT COMMIT)
# ==============================================
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
