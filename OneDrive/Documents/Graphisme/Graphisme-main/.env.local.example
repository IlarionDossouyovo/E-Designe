# ==============================================
# Graphisme by ELECTRON - Local Environment Variables
# ==============================================
# Copiez ce fichier vers .env.local et configurez vos clés API

# ==============================================
# CORE CONFIGURATION ⭐
# ==============================================

NODE_ENV=development
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=votre-secret-key-generer-avec-openssl

# ==============================================
# AUTHENTIFICATION - OAuth (Optionnel)
# =============================================

# Google OAuth - Obtenez sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=votre-google-client-id
GOOGLE_CLIENT_SECRET=votre-google-client-secret

# Facebook OAuth - Obtenez sur https://developers.facebook.com
FACEBOOK_APP_ID=votre-facebook-app-id
FACEBOOK_APP_SECRET=votre-facebook-app-secret

# ==============================================
# AI SERVICES CONFIGURATION ⭐⭐⭐
# =============================================

# Ollama (Local AI - déjà configuré par défaut)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google AI (Gemini) - RECOMMANDÉ POUR PRODUCTION
# Obtenez votre clé sur: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=votre-google-ai-api-key-ici

# OpenAI (Optionnel)
OPENAI_API_KEY=sk-votre-openai-api-key

# Anthropic Claude (Optionnel)
ANTHROPIC_API_KEY=sk-ant-votre-anthropic-api-key

# ==============================================
# SOCIAL MEDIA APIs (Optionnel)
# =============================================

FACEBOOK_ACCESS_TOKEN=votre-facebook-token
INSTAGRAM_ACCESS_TOKEN=votre-instagram-token
TIKTOK_ACCESS_TOKEN=votre-tiktok-token

# ==============================================
# MESSAGING (Optionnel)
# =============================================

WHATSAPP_ACCESS_TOKEN=votre-whatsapp-token
TELEGRAM_BOT_TOKEN=votre-telegram-bot-token

# ==============================================
# EMAIL SERVICES ⭐
# =============================================

# Resend (Recommandé pour emails transactionnels)
# Obtenez votre clé sur: https://resend.com
RESEND_API_KEY=re_votre-resend-api-key
EMAIL_FROM=noreply@graphisme.electron

# ==============================================
# PAYMENT PROCESSING ⭐⭐⭐
# =============================================

# Stripe - Obtenez vos clés sur: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_votre-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_votre-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_votre-publishable-key

# PayPal - Obtenez vos clés sur: https://developer.paypal.com
PAYPAL_CLIENT_ID=votre-paypal-client-id
PAYPAL_CLIENT_SECRET=votre-paypal-secret

# ==============================================
# ANALYTICS (Optionnel)
# =============================================

NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
